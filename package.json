{
  "name": "start-template",
  "version": "1.0.0",
  "description": "Quick start template based on monorepo",
  "keywords": [
    "monorepo",
    "template"
  ],
  "license": "MIT",
  "author": "Bin",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "vp check",
    "dev": "turbo run dev",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "format": "vp fmt .",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "prepare": "vp config",
    "test": "turbo run test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "tsx": "catalog:tooling",
    "turbo": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite-plus": "catalog:tooling",
    "vitepress": "catalog:tooling",
    "vitest": "catalog:testing"
  },
  "lint-staged": {
    "*": [
      "vp check --fix"
    ]
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.34.1"
}
