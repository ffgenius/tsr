{
  "name": "@ffgenius/tsr",
  "version": "0.0.1",
  "description": "TSR is a set of TypeScript tooling inspired by Rust",
  "keywords": [
    "rust",
    "typescript"
  ],
  "license": "MIT",
  "author": "Bin",
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack -w",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "format": "vp fmt .",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "prepare": "vp config",
    "release": "vp check && vp test && pnpm build && bumpp && pnpm publish",
    "test": "vp test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ts-pattern": "catalog:runtime"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "bumpp": "catalog:tooling",
    "tsx": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "^8.0.10",
    "vite-plus": "catalog:tooling",
    "vitepress": "catalog:tooling",
    "vitest": "catalog:testing",
    "void": "1.2.1"
  },
  "lint-staged": {
    "*": [
      "vp check --fix"
    ]
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.34.1"
}
